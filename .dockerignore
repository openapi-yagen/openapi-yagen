# Keeps the build context (COPY . /sources/ in Dockerfile.musl/.uclibc/.wasm) from dragging along
# generated/test-only trees the C++ build never touches - .git stays included, it's needed for
# CMakeLists.txt's `git describe --tags` version string. /dist is NOT excluded: Dockerfile (unlike
# the others) does no compiling of its own, it just COPYs a prebuilt dist/openapi-yagen-linux-<arch>
# binary from there.
/build
/build-macos-*
/generators/out
/generators/*/test/.gradle
/generators/*/test/.kotlin
/generators/*/test/build
/generators/*/test/node_modules
/generators/*/test/dist
/generators/*/test/.venv
/generators/*/test/.pytest_cache
/generators/*/test/generated
/generators/*/test/generated-default
/generators/*/test/generated-validated
/website/node_modules
/website/.docusaurus
/website/.generated-static
/website/build
