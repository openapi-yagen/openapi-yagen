{%- include "templates/_macros.kt.j2" -%}
package {{ apisPackage }}

{% if referencedModels %}import {{ modelsPackage }}.*
{% endif %}import {{ packageName }}.*
import io.ktor.client.HttpClient
import io.ktor.client.call.body
import io.ktor.client.request.delete
import io.ktor.client.request.get
import io.ktor.client.request.head
import io.ktor.client.request.options
import io.ktor.client.request.patch
import io.ktor.client.request.post
import io.ktor.client.request.put
import io.ktor.client.request.setBody
import io.ktor.client.request.forms.FormDataContent
import io.ktor.client.request.forms.MultiPartFormDataContent
import io.ktor.client.request.forms.formData
import io.ktor.http.ContentType
import io.ktor.http.Parameters
import io.ktor.http.contentType

{{ docComment(tagDescription) }}class {{ tagClass }}(private val client: HttpClient, private val baseUrl: String = "") {
{% for op in operations %}
{% if op.docComment %}    {{ op.docComment | indent(4) }}
{% endif %}    suspend fun {{ op.name }}({{ op.signatureParams }}){% if op.returnsValue %}: {{ op.response.type }}{% endif %} {
{% filter indent(8, true) %}{% if op.returnsValue %}val response = client.{{ op.method }}("$baseUrl{{ op.pathExpr }}") {
{% else %}client.{{ op.method }}("$baseUrl{{ op.pathExpr }}") {
{% endif %}{% for p in op.queryParams %}{% if p.isArray %}    queryParamList({{ toStringLiteral(p.wireName) }}, {{ p.ktName }})
{% else %}{% if p.queryArms %}    {{ p.ktName }}?.let { v ->
        when (v) {
{% for arm in p.queryArms %}{% if arm.kind == "object" %}            is {{ p.type }}.{{ arm.wrapperName }} -> {
{% for f in arm.fields %}                queryParam({{ toStringLiteral(p.wireName + "[" + f.wireName + "]") }}, v.value.{{ f.ktName }})
{% endfor %}            }
{% else %}            is {{ p.type }}.{{ arm.wrapperName }} -> queryParam({{ toStringLiteral(p.wireName) }}, v.value)
{% endif %}{% endfor %}        }
    }
{% else %}    queryParam({{ toStringLiteral(p.wireName) }}, {{ p.ktName }})
{% endif %}{% endif %}{% endfor %}{% for p in op.headerParams %}    headerParam({{ toStringLiteral(p.wireName) }}, {{ p.ktName }})
{% endfor %}{% for p in op.cookieParams %}    cookieParam({{ toStringLiteral(p.wireName) }}, {{ p.ktName }})
{% endfor %}{% if op.body %}{% if op.body.encoding == "urlencoded" %}    setBody(FormDataContent(Parameters.build {
{% for f in op.body.fields %}{% if f.isArray %}        body.{{ f.ktName }}?.forEach { append({{ toStringLiteral(f.wireName) }}, it.toString()) }
{% else %}        body.{{ f.ktName }}?.let { append({{ toStringLiteral(f.wireName) }}, it.toString()) }
{% endif %}{% endfor %}    }))
{% else if op.body.encoding == "multipart" %}    setBody(MultiPartFormDataContent(formData {
{% for f in op.body.fields %}{% if f.isFile %}{% if f.nullable %}        body.{{ f.ktName }}?.let { append({{ toStringLiteral(f.wireName) }}, it) }
{% else %}        append({{ toStringLiteral(f.wireName) }}, body.{{ f.ktName }})
{% endif %}{% else if f.isArray %}        body.{{ f.ktName }}?.forEach { append({{ toStringLiteral(f.wireName) }}, it.toString()) }
{% else %}        body.{{ f.ktName }}?.let { append({{ toStringLiteral(f.wireName) }}, it.toString()) }
{% endif %}{% endfor %}    }))
{% else if op.body.encoding == "text" or op.body.encoding == "bytes" %}    contentType(ContentType.parse({{ toStringLiteral(op.body.mediaType) }}))
    setBody(body)
{% else %}    contentType(ContentType.Application.Json)
    setBody(body)
{% endif %}{% endif %}}{% if op.returnsValue %}
return response.body(){% endif %}{% endfilter %}
    }
{% endfor %}
}
