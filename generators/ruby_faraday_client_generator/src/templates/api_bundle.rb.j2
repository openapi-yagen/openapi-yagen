{% if apiDescription %}{{ apiDescription | indent("  # ", true) }}
{% endif %}  class ApiClient
{% if tagGroups %}    attr_reader {% for g in tagGroups %}:{{ g.propertyName }}{% if not loop.is_last %}, {% endif %}{% endfor %}

{% endif %}    # @param connection [Faraday::Connection] a connection the caller has already configured -
    #   shared by every tag's client class.
    # @param base_url [String]
