package {{ packageName }}

import kotlinx.serialization.KSerializer
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.JsonArray
import kotlinx.serialization.json.JsonContentPolymorphicSerializer
import kotlinx.serialization.json.JsonElement
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.JsonPrimitive

@Serializable(with = {{ model.name }}.Serializer::class)
sealed interface {{ model.name }}{% if model.implements %} : {{ model.implements }}{% endif %} {
{% for v in model.variants -%}
    @Serializable
    data class {{ v.wrapperName }}(val value: {{ v.valueType }}) : {{ model.name }}

{% endfor -%}
    object Serializer : JsonContentPolymorphicSerializer<{{ model.name }}>({{ model.name }}::class) {
        override fun selectDeserializer(element: JsonElement): KSerializer<out {{ model.name }}> = when {
{% for v in model.variants -%}
{% if v.dispatchKind == "object" -%}
{% if v.dispatchField -%}
            element is JsonObject && "{{ v.dispatchField }}" in element -> {{ v.wrapperName }}.serializer()
{% else -%}
            element is JsonObject -> {{ v.wrapperName }}.serializer()
{% endif -%}
{% else if v.dispatchKind == "array" -%}
            element is JsonArray -> {{ v.wrapperName }}.serializer()
{% else if v.dispatchKind == "string" -%}
            element is JsonPrimitive && element.isString -> {{ v.wrapperName }}.serializer()
{% else if v.dispatchKind == "boolean" -%}
            element is JsonPrimitive && !element.isString && (element.content == "true" || element.content == "false") -> {{ v.wrapperName }}.serializer()
{% else if v.dispatchKind == "number" -%}
            element is JsonPrimitive && !element.isString && element.content.toDoubleOrNull() != null -> {{ v.wrapperName }}.serializer()
{% endif -%}
{% endfor -%}
            else -> throw IllegalArgumentException("Unrecognized JSON shape for {{ model.name }}: $element")
        }
    }
}
