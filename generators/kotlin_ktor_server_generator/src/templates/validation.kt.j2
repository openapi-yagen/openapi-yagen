package {{ packageName }}

import io.ktor.http.Parameters
import io.ktor.server.plugins.BadRequestException
import io.ktor.server.plugins.MissingRequestParameterException
import io.ktor.server.routing.RoutingCall

// Shared request-parsing/validation helpers - generated once and called from every route instead
// of duplicating parameter parsing and constraint checks per operation (see api_routes.kt.j2 and
// the validate() extension generated for constrained models).

fun RoutingCall.requirePathParam(name: String): String =
    pathParameters[name] ?: throw MissingRequestParameterException(name)

// convert() throws IllegalArgumentException on an unparseable value - String.toInt/toLong/
// toFloat/toDouble throw NumberFormatException (itself an IllegalArgumentException), and a
// generated enum's fromWireValue (see model_enum.kt.j2) throws IllegalArgumentException directly
// for an unrecognized value - both rethrown here as the same BadRequestException quality as a
// constraint violation, instead of a bare, unhandled exception.
private fun <T> convertOrThrow(raw: String, name: String, typeName: String, convert: (String) -> T): T =
    try {
        convert(raw)
    } catch (e: IllegalArgumentException) {
        throw BadRequestException("Field \"$name\" is not a valid $typeName")
    }

fun <T> RoutingCall.pathParamAs(name: String, typeName: String, convert: (String) -> T): T =
    convertOrThrow(requirePathParam(name), name, typeName, convert)

fun <T> RoutingCall.queryParamAs(name: String, typeName: String, convert: (String) -> T): T? =
    request.queryParameters[name]?.let { convertOrThrow(it, name, typeName, convert) }

fun <T> RoutingCall.requireQueryParamAs(name: String, typeName: String, convert: (String) -> T): T =
    convertOrThrow(request.queryParameters[name] ?: throw MissingRequestParameterException(name), name, typeName, convert)

// OpenAPI 3's default array-typed query parameter serialization (`style: form, explode: true`):
// one repeated `name=` key per element, e.g. `?ids=1&ids=2` - not a single comma-joined value.
// `typeName` describes the ITEM type (convertOrThrow's error message applies per element).
fun <T> RoutingCall.queryParamListAs(name: String, typeName: String, convert: (String) -> T): List<T>? =
    request.queryParameters.getAll(name)?.map { convertOrThrow(it, name, typeName, convert) }

fun <T> RoutingCall.requireQueryParamListAs(name: String, typeName: String, convert: (String) -> T): List<T> =
    request.queryParameters.getAll(name)?.map { convertOrThrow(it, name, typeName, convert) }
        ?: throw MissingRequestParameterException(name)

// Same shape as queryParamAs/requireQueryParamAs above, but reads from an already-parsed
// Parameters object instead of RoutingCall.request.queryParameters - what a urlencoded request
// body's fields need (see api_routes.kt.j2's call.receiveParameters()), since that's a plain
// Parameters value with no ApplicationCall of its own to be an extension on.
fun <T> Parameters.paramAs(name: String, typeName: String, convert: (String) -> T): T? =
    this[name]?.let { convertOrThrow(it, name, typeName, convert) }

fun <T> Parameters.requireParamAs(name: String, typeName: String, convert: (String) -> T): T =
    convertOrThrow(this[name] ?: throw MissingRequestParameterException(name), name, typeName, convert)

fun <T> RoutingCall.headerParamAs(name: String, typeName: String, convert: (String) -> T): T? =
    request.headers[name]?.let { convertOrThrow(it, name, typeName, convert) }

fun <T> RoutingCall.requireHeaderParamAs(name: String, typeName: String, convert: (String) -> T): T =
    convertOrThrow(request.headers[name] ?: throw MissingRequestParameterException(name), name, typeName, convert)

// Extracts a bearer token from the Authorization header for an `http`/`bearer` securityScheme,
// stripping the "Bearer " prefix if present (some clients send just the raw token).
fun RoutingCall.requireBearerToken(headerName: String): String {
    val raw = request.headers[headerName] ?: throw MissingRequestParameterException(headerName)
    val prefix = "Bearer "
    return if (raw.startsWith(prefix, ignoreCase = true)) raw.substring(prefix.length) else raw
}

// Extracts an apiKey securityScheme's value from wherever its `in` says it lives.
fun RoutingCall.requireApiKey(location: String, name: String): String =
    when (location) {
        "header" -> request.headers[name]
        "query" -> request.queryParameters[name]
        "cookie" -> request.cookies[name]
        else -> throw IllegalStateException("Unsupported apiKey location: $location")
    } ?: throw MissingRequestParameterException(name)

fun requireMax(value: Number?, max: Double, field: String) {
    if (value != null && value.toDouble() > max) throw BadRequestException("Field \"$field\" must be <= $max")
}

fun requireMin(value: Number?, min: Double, field: String) {
    if (value != null && value.toDouble() < min) throw BadRequestException("Field \"$field\" must be >= $min")
}

fun requireMaxLength(value: String?, max: Int, field: String) {
    if (value != null && value.length > max) throw BadRequestException("Field \"$field\" must have length <= $max")
}

fun requireMinLength(value: String?, min: Int, field: String) {
    if (value != null && value.length < min) throw BadRequestException("Field \"$field\" must have length >= $min")
}

fun requirePattern(value: String?, pattern: String, field: String) {
    if (value != null && !Regex(pattern).matches(value))
        throw BadRequestException("Field \"$field\" does not match pattern $pattern")
}
