package {{ packageName }}

import io.ktor.http.HttpStatusCode
import io.ktor.server.request.receive
import io.ktor.server.request.receiveMultipart
import io.ktor.server.request.receiveParameters
import io.ktor.server.response.respond
import io.ktor.server.routing.Route
import io.ktor.server.routing.delete
import io.ktor.server.routing.get
import io.ktor.server.routing.head
import io.ktor.server.routing.options
import io.ktor.server.routing.patch
import io.ktor.server.routing.post
import io.ktor.server.routing.put

// Parses and validates each request (path/query/header parameters via Validation.kt, and the
// body via its generated validate() when the body model has constraints) before calling into
// the handler - handler implementations only ever see clean, typed, already-validated values.
{{ docComment(tagDescription) }}class {{ tagClass }}Routes(route: Route, private val handler: {{ tagClass }}Handler) {
    init {
{% for op in operations %}
{% if op.docComment %}        {{ op.docComment | indent(8) }}
{% endif %}        route.{{ op.method }}({{ toStringLiteral(op.pathStr) }}) {
{% filter indent(12, true) %}{% for p in op.pathParams %}{{ extractAndValidate(p) }}{% endfor %}{% for p in op.queryParams %}{% if p.queryFilter %}val {{ p.ktName }}: {{ p.type }}? = call.queryParamAs({{ toStringLiteral(p.wireName) }}, "{{ p.queryFilter.scalarTypeLabel }}") { {{ p.queryFilter.scalarConverter }} }?.let { {{ p.type }}.{{ p.queryFilter.scalarWrapper }}(it) }
    ?: if ({% for f in p.queryFilter.fields %}call.request.queryParameters[{{ toStringLiteral(p.wireName + "[" + f.wireName + "]") }}] != null{% if not loop.is_last %} || {% endif %}{% endfor %}) {
        {{ p.type }}.{{ p.queryFilter.objectWrapper }}({{ p.queryFilter.objectValueType }}(
{% for f in p.queryFilter.fields %}            {{ f.ktName }} = call.queryParamAs({{ toStringLiteral(p.wireName + "[" + f.wireName + "]") }}, "{{ f.typeLabel }}") { {{ f.converter }} },
{% endfor %}        ))
    } else null
{% else %}{{ extractAndValidate(p) }}{% endif %}{% endfor %}{% for p in op.headerParams %}{{ extractAndValidate(p) }}{% endfor %}{% for p in op.authParams %}val {{ p.ktName }} = {{ p.extractExpr }}
{% endfor %}{% if op.body %}{% if op.body.encoding == "multipart" %}val body = call.receiveMultipart()

{% else if op.body.encoding == "urlencoded" %}val bodyParams = call.receiveParameters()
val body = {{ op.body.type }}(
{% for f in op.body.fields %}    {{ f.ktName }} = bodyParams.{% if f.nullable %}paramAs{% else %}requireParamAs{% endif %}({{ toStringLiteral(f.wireName) }}, {{ toStringLiteral(f.typeLabel) }}) { {{ f.converter }} },
{% endfor %}){% if op.body.hasValidate %}.validate(){% endif %}

{% else %}val body = call.receive<{{ op.body.type }}>(){% if op.body.hasValidate %}.validate(){% endif %}

{% endif %}{% endif %}{% if op.returnsValue %}val result = handler.{{ op.name }}({{ op.handlerArgs }})
call.respond(HttpStatusCode.fromValue({{ op.response.statusCode }}), result)
{% else %}handler.{{ op.name }}({{ op.handlerArgs }})
call.respond(HttpStatusCode.fromValue({{ op.response.statusCode }}))
{% endif %}{% endfilter %}        }
{% endfor %}
    }
}
