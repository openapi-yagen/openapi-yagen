# Deliberately actionpack (+ its actiondispatch/activesupport deps), NOT the full "rails" gem -
# no Rails::Application, no ActiveRecord/ActionView needed to exercise generated
# routes/controllers. See ../README.md for why.
gem "actionpack", "~> 8.0"
gem "rack-test"
gem "rake"
gem "minitest"
# No longer a default gem as of Ruby 3.5/4.0 (still required transitively by minitest's mock
# support) - unrelated to this generator, just keeps the suite runnable on newer Ruby.
gem "ostruct"
