module {{ moduleName }}
{% if model.description %}{{ model.description | indent("  # ", true) }}
{% endif %}  module {{ model.name }}
{% for e in model.entries %}    {{ e.constantName }} = {{ e.valueLiteral }}
{% endfor %}
    ALL_VALUES = [{% for e in model.entries %}{{ e.constantName }}{% if not loop.is_last %}, {% endif %}{% endfor %}].freeze

    # @param value [String, Integer, Float, nil] a raw wire value
    # @return [String, Integer, Float, nil] `value`, unchanged
    # @raise [Runtime::ValidationError] if `value` isn't nil and isn't one of ALL_VALUES - an
    #   incoming request's own enum value is untrusted client input, so this must be catchable by
    #   the same rescue_from a constraint violation is, not a bare ArgumentError.
    def self.from_h(value)
      return nil if value.nil?
      unless ALL_VALUES.include?(value)
        raise Runtime::ValidationError, "invalid #{name} value: #{value.inspect} (expected one of #{ALL_VALUES.inspect})"
      end
      value
    end

    # @param value [String, Integer, Float, nil]
    # @return [String, Integer, Float, nil] `value`, unchanged - already wire-shaped
    # @raise [Runtime::ValidationError] if `value` isn't nil and isn't one of
    #   ALL_VALUES{% if validate %} - caught here before a response is ever sent, not just when
    #   deserializing a request{% endif %}
    def self.to_wire(value)
{% if validate %}      return nil if value.nil?
      unless ALL_VALUES.include?(value)
        raise Runtime::ValidationError, "invalid #{name} value: #{value.inspect} (expected one of #{ALL_VALUES.inspect})"
      end
      value
{% else %}      value
{% endif %}    end
  end
end
