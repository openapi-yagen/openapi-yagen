{% endif %}  # Dispatches on the {{ toStringLiteral(model.property) }} discriminator property.
  module {{ model.name }}
    # @param h [Hash, nil] a parsed-JSON Hash (wire-shaped, string keys)
    # @return [Object, nil] an instance of whichever variant class the discriminator selects
    # @raise [Runtime::ValidationError] if the discriminator value doesn't match any known variant
    #   - an incoming request's own discriminator is untrusted client input, so this must be
    #   catchable by the same rescue_from a constraint violation is, not a bare ArgumentError.
    def self.from_h(h)
      return nil if h.nil?

      case h[{{ toStringLiteral(model.property) }}]
{% for v in model.variants %}      when {{ toStringLiteral(v.literal) }} then {{ v.className }}.from_h(h)
{% endfor %}      else
        raise Runtime::ValidationError, "unknown {{ model.name }} discriminator value: #{h[{{ toStringLiteral(model.property) }}].inspect}"
      end
    end

    # @param value [Object, nil] an instance of one of {{ model.name }}'s variant classes
    # @return [Hash, nil] wire-shaped Hash (string keys)
    def self.to_wire(value)
      return nil if value.nil?

      value.class.to_wire(value)
    end
  end
