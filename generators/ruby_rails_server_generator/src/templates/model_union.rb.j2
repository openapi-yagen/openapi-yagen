    # @return [Object, nil] wire-shaped value
    def self.to_wire(value)
      return nil if value.nil?

      case value
{% for v in model.variants %}{% if v.classPattern %}      when {{ v.classPattern }} then {{ v.toWireExpr }}
{% endif %}{% endfor %}      else
{% if validate %}        raise Runtime::ValidationError, "value does not match any variant of {{ model.name }}: #{value.class}"
