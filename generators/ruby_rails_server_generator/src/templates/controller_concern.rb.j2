  module {{ group.tagBase }}Controller
    extend ActiveSupport::Concern

    included do
      rescue_from Runtime::ValidationError, with: :render_openapi_validation_error
      rescue_from Runtime::MissingAuthenticationError, with: :render_openapi_missing_authentication_error
    end
{% for op in group.operations %}
    def {{ op.name }}
{% for stmt in op.statements %}      {{ stmt }}
{% endfor %}{% if op.bodyStatements %}{% for stmt in op.bodyStatements %}      {{ stmt }}
{% endfor %}{% endif %}      result = on_{{ op.name }}({% for k in op.handlerKwargs %}{{ k.rubyName }}: {{ k.rubyName }}{% if not loop.is_last %}, {% endif %}{% endfor %})
{% if not op.response.descriptor %}      head {{ op.response.statusCode }}
{% else %}{% if op.response.encoding == "json" %}      render json: {{ op.responseWireExpr }}, status: {{ op.response.statusCode }}
{% else %}      render body: {{ op.responseWireExpr }}, status: {{ op.response.statusCode }}
{% if op.response.mediaType %}      response.headers["Content-Type"] = {{ toStringLiteral(op.response.mediaType) }}
{% endif %}{% endif %}{% endif %}    end
{% endfor %}
{% for op in group.operations %}
{% for line in op.docLines %}    # {{ line }}
{% endfor %}    def on_{{ op.name }}({% for k in op.handlerKwargs %}{{ k.rubyName }}:{% if not k.required %} nil{% endif %}{% if not loop.is_last %}, {% endif %}{% endfor %})
      raise NotImplementedError, "#{self.class} must implement #on_{{ op.name }}"
    end
{% endfor %}
    private

    def render_openapi_validation_error(e)
      render json: { error: e.message }, status: :unprocessable_entity
    end

    def render_openapi_missing_authentication_error(e)
      render json: { error: e.message }, status: :unauthorized
    end
  end
