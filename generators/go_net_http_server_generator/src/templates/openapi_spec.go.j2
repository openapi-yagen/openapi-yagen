package server

import (
	_ "embed"
	"net/http"
)

//go:embed openapi.json
var openApiSpecJSON []byte

// RegisterOpenApiSpecRoute registers a route serving the OpenAPI document this package was
// generated from - the bytes are compiled into the binary at build time (see openapi.json next to
// this file), not read from disk at request time.
func RegisterOpenApiSpecRoute(mux *http.ServeMux) {
	mux.HandleFunc({{ openApiSpecPatternLiteral }}, func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.Write(openApiSpecJSON)
	})
}
